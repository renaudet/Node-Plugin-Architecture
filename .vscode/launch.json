{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start the APAF Test Server",
            "program": "app.js",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "cwd": "${workspaceFolder}\\src",
            "args": [],
            "envFile": "${workspaceFolder}\\src\\configs\\configMsi.env",
            "env": {
                "NODE_PATH_OLD": "${workspaceFolder}\\src\\node_modules"
            }
        }
    ]
}